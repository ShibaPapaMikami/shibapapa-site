---
/*
  金魚水槽 MRアートのメインビジュアル

  素材の有無で自動的に切り替わります（src/data/site.js の KINGYO_MEDIA）:

    1. video あり かつ allowVideo … 動画
    2. poster あり               … 静止画
    3. どちらも無し              … CSSの抽象表現（現状のプレースホルダ）

  トップでは allowVideo={false} を渡し、静止画までに留めています。
  実際の作品映像は「装飾」ではなく「証拠」なので、作品ページで見せます。
*/
import { KINGYO_MEDIA } from '../data/site.js';

const { label, allowVideo = false } = Astro.props;

const useVideo = allowVideo && Boolean(KINGYO_MEDIA.video);
const usePoster = !useVideo && Boolean(KINGYO_MEDIA.poster);
const loop = KINGYO_MEDIA.loop;
---

{useVideo && (
  <div class="work-visual work-visual-media">
    {loop ? (
      <video
        src={KINGYO_MEDIA.video}
        poster={KINGYO_MEDIA.poster ?? undefined}
        muted
        loop
        autoplay
        playsinline
        preload="metadata"
        aria-label={label}
      ></video>
    ) : (
      <video
        src={KINGYO_MEDIA.video}
        poster={KINGYO_MEDIA.poster ?? undefined}
        controls
        playsinline
        preload="none"
        aria-label={label}
      ></video>
    )}
  </div>
)}

{usePoster && (
  <div class="work-visual work-visual-media">
    <img src={KINGYO_MEDIA.poster} alt={label} loading="lazy" decoding="async" />
  </div>
)}

{!useVideo && !usePoster && (
  <div class="work-visual" role="img" aria-label={label}>
    <div class="tank" aria-hidden="true">
      <span class="tank-surface"></span>
      <span class="tank-glow"></span>
      <span class="fish fish-1"></span>
      <span class="fish fish-2"></span>
      <span class="fish fish-3"></span>
      <span class="trail trail-1"></span>
      <span class="trail trail-2"></span>
    </div>
  </div>
)}
