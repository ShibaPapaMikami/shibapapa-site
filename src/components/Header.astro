---
import { NAV_ITEMS, localePath, UI, otherLang } from '../data/nav.js';

const { lang = 'ja', currentKey = null, path = '/' } = Astro.props;
const other = otherLang(lang);
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={localePath('/', lang)} aria-label={UI.homeLabel[lang]}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-text">SHIBAPAPA</span>
    </a>

    <div class="header-tools">
      <nav class="nav" aria-label={UI.navLabel[lang]}>
        {NAV_ITEMS.map((item) => (
          <a
            href={localePath(item.path, lang)}
            aria-current={item.key === currentKey ? 'page' : undefined}
          >
            {item.label[lang]}
          </a>
        ))}
      </nav>

      <a
        class="lang-toggle"
        href={localePath(path, other)}
        lang={other}
        hreflang={other}
        aria-label={UI.langToggleAria[lang]}
      >
        {UI.langToggle[lang]}
      </a>
    </div>
  </div>
</header>
